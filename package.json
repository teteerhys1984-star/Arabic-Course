{
  "name": "arabic-course",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:lesson1": "node scripts/check-lesson1.mjs",
    "check:lesson2": "node scripts/check-lesson2.mjs",
    "check:lesson3": "node scripts/check-lesson3.mjs",
    "check:lesson4": "node scripts/check-lesson4.mjs",
    "check:lesson5": "node scripts/check-lesson5.mjs",
    "check:lesson6": "node scripts/check-lesson6.mjs",
    "check:lesson8": "node scripts/check-lesson8.mjs",
    "check:lesson9": "node scripts/check-lesson9.mjs",
    "check:lesson10": "node scripts/check-lesson10.mjs",
    "check:morphology-lesson-01": "node scripts/check-morphology-lesson-01.mjs",
    "check:parsing": "node scripts/check-parsing.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "validate": "npm run lint && npm run check:rtl && npm run check:architecture && npm run check:test-ux && npm run check:lesson1 && npm run check:lesson2 && npm run check:lesson3 && npm run check:lesson4 && npm run check:lesson5 && npm run check:lesson6 && npm run check:lesson7 && npm run check:lesson8 && npm run check:lesson9 && npm run check:lesson10 && npm run check:parsing && npm run check:morphology-lesson-01 && npm run check:morphology-source && npm run check:spelling-lesson-01 && npm run check:spelling-lesson-02 && npm run test && npm run build",
    "check:lesson7": "node scripts/check-lesson7.mjs",
    "check:morphology-source": "node --experimental-strip-types --no-warnings scripts/check-morphology-source.mjs",
    "check:test-ux": "node scripts/check-test-ux.mjs",
    "check:spelling-lesson-01": "node scripts/check-spelling-lesson-01.mjs",
    "check:spelling-lesson-02": "node scripts/check-spelling-lesson-02.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest"
  }
}
